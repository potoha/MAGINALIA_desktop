{
  "name": "maginalia-alpha",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "workspaces": [
    "packages/format",
    "packages/repository-core",
    "packages/source-core",
    "packages/writing-core",
    "apps/desktop"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "smoke": "npm run smoke --workspace @maginalia/desktop",
    "smoke:writing": "npm run smoke:writing --workspace @maginalia/desktop",
    "smoke:settings": "npm run smoke:settings --workspace @maginalia/desktop",
    "smoke:workspace": "npm run smoke:workspace --workspace @maginalia/desktop",
    "smoke:quotation": "npm run smoke:quotation --workspace @maginalia/desktop",
    "smoke:repository": "npm run smoke:repository --workspace @maginalia/desktop",
    "smoke:shelf": "npm run smoke:shelf --workspace @maginalia/desktop",
    "smoke:d5": "npm run smoke:d5 --workspace @maginalia/desktop",
    "smoke:export": "npm run smoke:export --workspace @maginalia/desktop",
    "smoke:g": "npm run smoke:g --workspace @maginalia/desktop",
    "smoke:h": "npm run smoke:h --workspace @maginalia/desktop",
    "smoke:workdesk-persistence": "npm run smoke:workdesk-persistence --workspace @maginalia/desktop",
    "smoke:first-run": "npm run smoke:first-run --workspace @maginalia/desktop",
    "dist:windows": "npm run build && npm run dist:windows --workspace @maginalia/desktop",
    "start": "npm run start --workspace @maginalia/desktop"
  }
}
