    "src/security.ts",
    "src/document-workspace.ts",
    "src/project-metadata.ts",
    "src/project-service.ts",
    "src/project-ipc.ts",
    "src/project-links.ts",
    "src/project-link-ipc.ts",
    "src/library-service.ts",
    "src/configured-private-shelf.ts",
    "src/shelf-location-registry.ts",
    "src/desktop-configuration.ts",
    "src/reviewer-ipc.ts",
    "src/reviewer-process-manager.ts",
    "src/reviewer-view-controller.ts",
    "src/reviewer-preload.ts",
    "src/reviewer-embedded-view-host.ts",
    "src/reference-ipc.ts",
    "src/export-ipc.ts",
    "src/mod-host.ts",
    "src/mod-bootstrap.ts",
    "src/workspace-state-ipc.ts",
    "src/workspace-state-service.ts",
    "src/workdesk-service.ts",
    "src/reviewer-resolution.ts",
    "src/repository-filesystem.ts",
    "src/repository-local-history.ts",
    "src/repository-service.ts"
  ]
}
