    "test": "npm run build && vitest run"
  },
  "dependencies": {
    "@maginalia/format": "0.1.0-alpha.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "typescript": "7.0.2",
    "vitest": "5.0.0"
  }
}
